{
  "name": "dukkanify",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "contracts:build": "npm run build -w @dukkanify/contracts",
    "predev": "npm run contracts:build",
    "dev": "node scripts/dev.mjs",
    "dev:apps": "concurrently -n api,web -c cyan,magenta \"npm run dev -w api\" \"npm run dev -w web\"",
    "start": "npm run dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "npm run contracts:build && npm run build -w api && npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w api",
    "db:deploy": "npm run db:deploy -w api",
    "db:seed": "npm run db:seed -w api",
    "prepare": "node scripts/prepare.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "zod": "^3.24.1"
  }
}
