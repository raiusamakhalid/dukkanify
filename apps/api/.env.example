DATABASE_URL="postgresql://dukkanify:dukkanify@localhost:5433/dukkanify?schema=public"
# Only for a hosted database whose DATABASE_URL points at a connection pooler: migrations
# need one session that stays put, so they run against the unpooled host instead. Leave
# unset locally — Docker Postgres has no pooler in front of it.
# DIRECT_URL="postgresql://user:password@host/dukkanify?sslmode=require"
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
# mock needs no key and no network; claude and gemini each need their own
AI_PROVIDER=mock
ANTHROPIC_API_KEY=sk-ant-xxxxx
GEMINI_API_KEY=xxxxx
# Leave unset to take the provider's default (claude-sonnet-5 / gemini-3.5-flash).
# A model name from the wrong vendor is a 404 at the first prompt, not at boot.
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=8000
JWT_SECRET=generate-with-openssl-rand-hex-32
# Token lifetime as <number><unit>, unit one of s m h d w
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
THROTTLE_TTL=60000
THROTTLE_LIMIT=30
